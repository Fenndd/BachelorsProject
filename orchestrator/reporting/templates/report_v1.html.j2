<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Experiment Report - {{ report.experiment.experiment_id|display }}</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #1f2933;
      --muted: #62717f;
      --line: #d8dee6;
      --panel: #f6f8fa;
      --accent: #246b8f;
    }
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--ink);
      background: #ffffff;
      line-height: 1.45;
    }
    main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 36px 28px 56px;
    }
    header {
      border-bottom: 2px solid var(--line);
      margin-bottom: 28px;
      padding-bottom: 24px;
    }
    h1 {
      margin: 0 0 8px;
      font-size: 32px;
    }
    h2 {
      border-bottom: 1px solid var(--line);
      font-size: 22px;
      margin: 34px 0 14px;
      padding-bottom: 6px;
    }
    .muted {
      color: var(--muted);
    }
    .summary-grid,
    .metric-grid {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    }
    .metric {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 12px;
    }
    .metric strong {
      display: block;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    figure {
      margin: 18px 0;
    }
    figure img {
      border: 1px solid var(--line);
      border-radius: 6px;
      max-width: 100%;
      width: 100%;
      height: auto;
    }
    table {
      border-collapse: collapse;
      font-size: 14px;
      width: 100%;
    }
    table.compact {
      font-size: 12px;
    }
    th,
    td {
      border: 1px solid var(--line);
      padding: 8px 9px;
      text-align: left;
      vertical-align: top;
    }
    th {
      background: var(--panel);
    }
    code {
      overflow-wrap: anywhere;
      color: #334155;
    }
    .plot-grid {
      display: grid;
      gap: 14px;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    }
    .badge {
      background: #eef3f7;
      border: 1px solid var(--line);
      border-radius: 999px;
      display: inline-block;
      font-size: 12px;
      padding: 2px 8px;
    }
    .appendix-card {
      border: 1px solid var(--line);
      border-radius: 6px;
      margin: 14px 0;
      padding: 12px;
      break-inside: avoid;
      page-break-inside: avoid;
    }
    .appendix-card h3 {
      font-size: 16px;
      margin: 0 0 10px;
    }
    .page-break-before {
      break-before: page;
      page-break-before: always;
    }
  </style>
</head>
<body>
<main>
  <header>
    <h1>Experiment Report</h1>
    <p class="muted">Experiment {{ report.experiment.experiment_id|display }} for <code>{{ report.experiment.target_file|display }}</code></p>
  </header>

  <section id="cover">
    <h2>Cover</h2>
    <div class="summary-grid">
      <div class="metric"><strong>Experiment ID</strong>{{ report.experiment.experiment_id|display }}</div>
      <div class="metric"><strong>Experiment Name</strong>{{ report.experiment.experiment_name|display }}</div>
      <div class="metric"><strong>Target File</strong><code>{{ report.experiment.target_file|display }}</code></div>
      <div class="metric"><strong>Generated At</strong>{{ report.report_metadata.generated_at|display }}</div>
      <div class="metric"><strong>Report Profile</strong>{{ report.report_metadata.report_profile|display }}</div>
    </div>
  </section>

  <section id="executive-summary">
    <h2>Executive Summary</h2>
    <div class="metric-grid">
      <div class="metric"><strong>Final Best Iteration</strong>{{ report.final_result.final_best_iteration|display }}</div>
      <div class="metric"><strong>Final Speedup vs Baseline</strong>{{ report.final_result.final_speedup_vs_baseline|display }}</div>
      <div class="metric"><strong>Final Runtime Reduction %</strong>{{ report.final_result.final_runtime_reduction_percent|display }}</div>
      <div class="metric"><strong>Accepted Improvements</strong>{{ report.final_result.accepted_improvements|display }}</div>
      <div class="metric"><strong>Correctness Preserved</strong>{{ report.final_result.correctness_preserved|yes_no }}</div>
      <div class="metric"><strong>Baseline Runtime ns/case</strong>{{ report.final_best_candidate.baseline_runtime_ns_per_case_median|display }}</div>
      <div class="metric"><strong>Final Best Runtime ns/case</strong>{{ report.final_best_candidate.runtime_ns_per_case_median|display }}</div>
      <div class="metric"><strong>Runtime Improvement ns/case</strong>{{ report.final_best_candidate.absolute_runtime_difference_ns_per_case|display }}</div>
      <div class="metric"><strong>PDF Report</strong>{{ report.reporting_status.pdf_display|display }}</div>
    </div>
  </section>

  <section id="experiment-configuration">
    <h2>Experiment Configuration</h2>
    <table>
      <tbody>
        <tr><th>Experiment Name</th><td>{{ report.experiment.experiment_name|display }}</td></tr>
        <tr><th>Description</th><td>{{ report.experiment_config_details.description|display }}</td></tr>
        <tr><th>Target File</th><td><code>{{ report.experiment.target_file|display }}</code></td></tr>
        <tr><th>LLM Provider</th><td>{{ report.llm.provider|display }}</td></tr>
        <tr><th>Model</th><td>{{ report.llm.model|display }}</td></tr>
        <tr><th>LLM Config</th><td>{{ report.llm.llm_config|display }}</td></tr>
        <tr><th>Thinking Enabled</th><td>{{ report.llm.thinking_enabled|yes_no }}</td></tr>
        <tr><th>Thinking Effort</th><td>{{ report.llm.thinking_effort|display }}</td></tr>
        <tr><th>Max Tokens</th><td>{{ report.llm.max_tokens|display }}</td></tr>
        <tr><th>Variant ID</th><td>{{ report.llm.variant_id|display }}</td></tr>
        <tr><th>Variant Description</th><td>{{ report.llm.variant_description|display }}</td></tr>
        <tr><th>Candidate Format</th><td>{{ report.experiment.candidate_format|display }}</td></tr>
        <tr><th>Source Presentation</th><td>{{ report.experiment.source_presentation|display }}</td></tr>
        <tr><th>Require Original Verification</th><td>{{ report.experiment_config_details.require_original_verification|yes_no }}</td></tr>
        <tr><th>Allow Exact Search Fallback</th><td>{{ report.experiment_config_details.allow_exact_search_fallback|yes_no }}</td></tr>
        <tr><th>Max Source Chars</th><td>{{ report.experiment_config_details.candidate_generation_max_source_chars|display }}</td></tr>
        <tr><th>Total Iterations</th><td>{{ report.experiment.total_iterations|display }}</td></tr>
        <tr><th>Completed Iterations</th><td>{{ report.experiment.completed_iterations|display }}</td></tr>
        <tr><th>Closed-loop Decision Logic</th><td>{{ report.experiment.closed_loop_enabled|yes_no }}</td></tr>
        <tr><th>Promotion Policy</th><td>{{ report.closed_loop_selection.promotion_policy|display }}</td></tr>
        <tr><th>Baseline Run Directory</th><td><code>{{ report.experiment_config_details.selection_baseline_run_dir|display }}</code></td></tr>
        <tr><th>Closed-loop History Context</th><td>{% if report.experiment.closed_loop_enabled %}enabled{% else %}Not available{% endif %}</td></tr>
        <tr><th>History Context Detail</th><td>{% if report.experiment.closed_loop_enabled %}Previous iteration summaries are included in candidate generation prompts.{% else %}Not available{% endif %}</td></tr>
        <tr><th>Optimization Scope</th><td><code>{{ report.experiment_config_details.optimization_scope_allowed_files|display }}</code></td></tr>
        <tr><th>Reporting Enabled</th><td>{{ report.experiment_config_details.reporting_enabled|yes_no }}</td></tr>
        <tr><th>Reporting Formats</th><td>{{ report.experiment_config_details.reporting_formats|display }}</td></tr>
        <tr><th>Reporting Renderer</th><td>{{ report.experiment_config_details.reporting_renderer|display }}</td></tr>
        <tr><th>Benchmark Family</th><td>{{ report.experiment.benchmark_family|display }}</td></tr>
        <tr><th>Build Type</th><td>{{ report.benchmark_config.build_type|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="benchmark-configuration">
    <h2>Benchmark Configuration</h2>
    <table>
      <tbody>
        <tr><th>Family</th><td>{{ report.benchmark_config.family|display }}</td></tr>
        <tr><th>Solver</th><td>{{ report.benchmark_config.solver|display }}</td></tr>
        <tr><th>Num Cases</th><td>{{ report.benchmark_config.num_cases|display }}</td></tr>
        <tr><th>Points per Case</th><td>{{ report.benchmark_config.points_per_case|display }}</td></tr>
        <tr><th>Warmup Iterations</th><td>{{ report.benchmark_config.warmup_iterations|display }}</td></tr>
        <tr><th>Timed Iterations</th><td>{{ report.benchmark_config.timed_iterations|display }}</td></tr>
        <tr><th>Seed</th><td>{{ report.benchmark_config.seed|display }}</td></tr>
        <tr><th>Runtime Unit</th><td>{{ report.benchmark_config.runtime_unit|display }}</td></tr>
        <tr><th>Reprojection Error Threshold</th><td>{{ report.benchmark_config.reprojection_error_threshold|display }}</td></tr>
        <tr><th>Minimum Success Rate</th><td>{{ report.benchmark_config.minimum_success_rate|display }}</td></tr>
        <tr><th>Require All Cases Valid</th><td>{{ report.benchmark_config.require_all_cases_valid|yes_no }}</td></tr>
        <tr><th>Use Max Reprojection Error as Hard Gate</th><td>{{ report.benchmark_config.use_max_reprojection_error_as_hard_gate|yes_no }}</td></tr>
        <tr><th>Build Type</th><td>{{ report.benchmark_config.build_type|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="final-validation">
    <h2>Final Repeated Benchmark Validation</h2>
    {% if report.final_validation.diagnostics.summary %}
    <p class="muted">{{ report.final_validation.diagnostics.summary }}</p>
    {% if report.final_validation.diagnostics.dominant_failed_step %}
    <p><strong>Dominant failed step:</strong> <code>{{ report.final_validation.diagnostics.dominant_failed_step }}</code></p>
    {% endif %}
    {% if report.final_validation.diagnostics.suggested_log_paths %}
    <p><strong>Suggested logs:</strong> <code>{{ report.final_validation.diagnostics.suggested_log_paths|display }}</code></p>
    {% endif %}
    {% endif %}
    {% if report.final_validation.enabled is true %}
    <p class="muted">Final repeated validation compares the original baseline source with the final optimized source. It is reporting/evaluation only and does not affect candidate promotion or current_best_source.</p>
    <div class="metric-grid">
      <div class="metric"><strong>Enabled</strong>{{ report.final_validation.enabled|yes_no }}</div>
      <div class="metric"><strong>Status</strong>{{ report.final_validation.status|display }}</div>
      <div class="metric"><strong>Benchmark Repetitions</strong>{{ report.final_validation.benchmark_repetitions|display }}</div>
      <div class="metric"><strong>Successful Baseline Runs</strong>{{ report.final_validation.baseline.successful_runs|display }}</div>
      <div class="metric"><strong>Successful Final Runs</strong>{{ report.final_validation.final.successful_runs|display }}</div>
      <div class="metric"><strong>Baseline Median Runtime</strong>{{ report.final_validation.baseline.median_runtime_ns_per_case|display }}</div>
      <div class="metric"><strong>Final Median Runtime</strong>{{ report.final_validation.final.median_runtime_ns_per_case|display }}</div>
      <div class="metric"><strong>Median Speedup</strong>{{ report.final_validation.comparison.median_speedup|display }}</div>
      <div class="metric"><strong>Median Runtime Reduction %</strong>{{ report.final_validation.comparison.median_runtime_reduction_percent|display }}</div>
      <div class="metric"><strong>Baseline Correctness Passed</strong>{{ report.final_validation.baseline.all_correctness_passed|yes_no }}</div>
      <div class="metric"><strong>Final Correctness Passed</strong>{{ report.final_validation.final.all_correctness_passed|yes_no }}</div>
    </div>
    <figure><img src="{{ plots.final_validation_runtime_distribution }}" alt="Final validation runtime distribution plot"></figure>
    <table class="compact">
      <thead><tr><th>Group</th><th>Mean</th><th>Std</th><th>Min</th><th>Max</th><th>Success Rate Mean</th><th>Success Rate Min</th></tr></thead>
      <tbody>
        <tr><td>Baseline</td><td>{{ report.final_validation.baseline.mean_runtime_ns_per_case|display }}</td><td>{{ report.final_validation.baseline.std_runtime_ns_per_case|display }}</td><td>{{ report.final_validation.baseline.min_runtime_ns_per_case|display }}</td><td>{{ report.final_validation.baseline.max_runtime_ns_per_case|display }}</td><td>{{ report.final_validation.baseline.success_rate_mean|display }}</td><td>{{ report.final_validation.baseline.success_rate_min|display }}</td></tr>
        <tr><td>Final</td><td>{{ report.final_validation.final.mean_runtime_ns_per_case|display }}</td><td>{{ report.final_validation.final.std_runtime_ns_per_case|display }}</td><td>{{ report.final_validation.final.min_runtime_ns_per_case|display }}</td><td>{{ report.final_validation.final.max_runtime_ns_per_case|display }}</td><td>{{ report.final_validation.final.success_rate_mean|display }}</td><td>{{ report.final_validation.final.success_rate_min|display }}</td></tr>
      </tbody>
    </table>
    {% elif report.final_validation.enabled is false %}
    <p class="muted">Final repeated benchmark validation was disabled/skipped for this experiment.</p>
    <div class="metric-grid">
      <div class="metric"><strong>Enabled</strong>{{ report.final_validation.enabled|yes_no }}</div>
      <div class="metric"><strong>Status</strong>{{ report.final_validation.status|display }}</div>
      <div class="metric"><strong>Benchmark Repetitions</strong>{{ report.final_validation.benchmark_repetitions|display }}</div>
    </div>
    {% else %}
    <p class="muted">Final repeated benchmark validation was not available for this experiment.</p>
    <figure><img src="{{ plots.final_validation_runtime_distribution }}" alt="Final validation data unavailable"></figure>
    {% endif %}
  </section>

  <section id="baseline-metrics">
    <h2>Baseline Metrics</h2>
    <div class="metric-grid">
      <div class="metric"><strong>Median Runtime ns/case</strong>{{ report.baseline_metrics.runtime_ns_per_case_median|display }}</div>
      <div class="metric"><strong>Success Rate</strong>{{ report.baseline_metrics.success_rate|display }}</div>
      <div class="metric"><strong>Mean Reprojection Error</strong>{{ report.baseline_metrics.mean_reprojection_error|display }}</div>
      <div class="metric"><strong>Max Reprojection Error</strong>{{ report.baseline_metrics.max_reprojection_error|display }}</div>
      <div class="metric"><strong>Correctness Passed</strong>{{ report.baseline_metrics.correctness_passed|yes_no }}</div>
    </div>
  </section>

  <section id="runtime-progress">
    <h2>Runtime Progress</h2>
    <figure><img src="{{ plots.runtime_progress }}" alt="Current best runtime progress plot"></figure>
    <figure><img src="{{ plots.candidate_runtime_by_iteration }}" alt="Candidate runtime by iteration plot"></figure>
    <figure><img src="{{ plots.runtime_reduction_by_iteration }}" alt="Runtime reduction by iteration plot"></figure>
  </section>

  <section id="correctness-and-accuracy-safety">
    <h2>Correctness and Accuracy Safety</h2>
    <figure><img src="{{ plots.correctness_metrics }}" alt="Correctness metrics plot"></figure>
  </section>

  <section id="status-breakdown">
    <h2>Status Breakdown</h2>
    <figure><img src="{{ plots.status_breakdown }}" alt="Status breakdown plot"></figure>
    <table>
      <thead><tr><th>Status</th><th>Count</th></tr></thead>
      <tbody>
      {% for status, count in status_items %}
        <tr><td>{{ status }}</td><td>{{ count }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="candidate-funnel">
    <h2>Candidate Funnel</h2>
    <figure><img src="{{ plots.candidate_funnel }}" alt="Candidate funnel plot"></figure>
  </section>

  <section id="reproducibility-environment">
    <h2>Reproducibility and Environment</h2>
    <table>
      <tbody>
        <tr><th>Started At</th><td>{{ report.experiment_metadata.started_at|display }}</td></tr>
        <tr><th>Finished At</th><td>{{ report.experiment_metadata.finished_at|display }}</td></tr>
        <tr><th>Total Duration s</th><td>{{ report.experiment_metadata.total_duration_seconds|display }}</td></tr>
        <tr><th>Git Commit</th><td>{{ report.experiment_metadata.repository.git_commit|display }}</td></tr>
        <tr><th>Git Branch</th><td>{{ report.experiment_metadata.repository.git_branch|display }}</td></tr>
        <tr><th>Dirty Worktree</th><td>{{ report.experiment_metadata.repository.dirty_worktree|display }}</td></tr>
        <tr><th>OS</th><td>{{ report.experiment_metadata.environment.os|display }}</td></tr>
        <tr><th>Platform</th><td>{{ report.experiment_metadata.environment.platform|display }}</td></tr>
        <tr><th>Python Version</th><td>{{ report.experiment_metadata.environment.python_version|display }}</td></tr>
        <tr><th>CMake Build Type</th><td>{{ report.experiment_metadata.environment.cmake_build_type|display }}</td></tr>
        <tr><th>CMake Executable</th><td>{{ report.experiment_metadata.environment.cmake_exe|display }}</td></tr>
        <tr><th>CMake Generator</th><td>{{ report.experiment_metadata.environment.cmake_generator|display }}</td></tr>
        <tr><th>C++ Compiler</th><td>{{ report.experiment_metadata.environment.cxx_compiler|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="failure-analysis">
    <h2>Outcome and Failure Analysis</h2>
    <p class="muted">Structured outcome reason codes summarize why each iteration reached its final status, including accepted improvements, valid-but-not-promoted candidates, rejected candidates, and pipeline failures.</p>
    <figure><img src="{{ plots.failure_reason_breakdown }}" alt="Outcome reason breakdown plot"></figure>
    {% if report.reason_code_counts %}
    <table class="compact">
      <thead><tr><th>Category</th><th>Reason Code</th><th>Count</th><th>Iterations</th></tr></thead>
      <tbody>
      {% for item in report.reason_code_counts %}
        <tr>
          <td>{{ item.category|display }}</td>
          <td>{{ item.code|display }}</td>
          <td>{{ item.count|display }}</td>
          <td>{{ item.iterations | join(', ') }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p>No structured outcome reasons are available for this report.</p>
    {% endif %}
  </section>

  <section id="phase-timings">
    <h2>Phase Timings</h2>
    <p class="muted">Verification time includes build, smoke tests, adapter validation, benchmark execution, parsing, and correctness checks.</p>
    <figure><img src="{{ plots.phase_timings }}" alt="Phase timings plot"></figure>
    <table class="compact">
      <thead>
        <tr>
          <th>Iteration</th>
          <th>Generation s</th>
          <th>Materialization s</th>
          <th>Verification s</th>
          <th>Total s</th>
        </tr>
      </thead>
      <tbody>
      {% for iteration in report.iterations %}
        <tr>
          <td>{{ iteration.iteration|display }}</td>
          <td>{{ iteration.phase_timings.generation_seconds|display }}</td>
          <td>{{ iteration.phase_timings.materialization_seconds|display }}</td>
          <td>{{ iteration.phase_timings.verification_seconds|display }}</td>
          <td>{{ iteration.phase_timings.total_iteration_seconds|display }}</td>
        </tr>
      {% else %}
        <tr><td colspan="5">No iterations recorded.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="llm-usage">
    <h2>LLM Usage</h2>
    <div class="metric-grid">
      <div class="metric"><strong>Total Tokens</strong>{{ report.llm_usage_summary.total_tokens|display }}</div>
      <div class="metric"><strong>Prompt Tokens</strong>{{ report.llm_usage_summary.prompt_tokens_total|display }}</div>
      <div class="metric"><strong>Completion Tokens</strong>{{ report.llm_usage_summary.completion_tokens_total|display }}</div>
      <div class="metric"><strong>Total API Latency s</strong>{{ report.llm_usage_summary.api_latency_seconds_total|display }}</div>
      <div class="metric"><strong>Average API Latency s</strong>{{ report.llm_usage_summary.api_latency_seconds_average|display }}</div>
      <div class="metric"><strong>Iterations with Usage</strong>{{ report.llm_usage_summary.iterations_with_usage|display }}</div>
      <div class="metric"><strong>Most Expensive Iteration</strong>{{ report.llm_usage_summary.most_expensive_iteration|display }}</div>
      <div class="metric"><strong>Highest Latency Iteration</strong>{{ report.llm_usage_summary.highest_latency_iteration|display }}</div>
    </div>
    <div class="plot-grid">
      <figure><img src="{{ plots.llm_tokens_by_iteration }}" alt="LLM token usage by iteration plot"></figure>
      <figure><img src="{{ plots.llm_latency_by_iteration }}" alt="LLM latency by iteration plot"></figure>
    </div>
    <table class="compact">
      <thead>
        <tr>
          <th>Iteration</th>
          <th>Model</th>
          <th>Prompt Tokens</th>
          <th>Completion Tokens</th>
          <th>Total Tokens</th>
          <th>API Latency s</th>
          <th>Finish Reason</th>
        </tr>
      </thead>
      <tbody>
      {% for iteration in report.iterations %}
        <tr>
          <td>{{ iteration.iteration|display }}</td>
          <td>{{ iteration.llm_usage.model|display }}</td>
          <td>{{ iteration.llm_usage.prompt_tokens|display }}</td>
          <td>{{ iteration.llm_usage.completion_tokens|display }}</td>
          <td>{{ iteration.llm_usage.total_tokens|display }}</td>
          <td>{{ iteration.llm_usage.api_latency_seconds|display }}</td>
          <td>{{ iteration.llm_usage.finish_reason|display }}</td>
        </tr>
      {% else %}
        <tr><td colspan="7">No iterations recorded.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="diff-statistics">
    <h2>Diff Statistics</h2>
    {% if report.final_best_candidate.diff_stats %}
    <div class="metric-grid">
      <div class="metric"><strong>Final Files Changed</strong>{{ report.final_best_candidate.diff_stats.files_changed|display }}</div>
      <div class="metric"><strong>Final Lines Added</strong>{{ report.final_best_candidate.diff_stats.lines_added|display }}</div>
      <div class="metric"><strong>Final Lines Removed</strong>{{ report.final_best_candidate.diff_stats.lines_removed|display }}</div>
      <div class="metric"><strong>Final Changed Blocks</strong>{{ report.final_best_candidate.diff_stats.changed_blocks|display }}</div>
    </div>
    {% else %}
    <p class="muted">Final diff summary is not available.</p>
    {% endif %}
    <figure><img src="{{ plots.diff_stats_by_iteration }}" alt="Diff statistics by iteration plot"></figure>
    <table class="compact">
      <thead>
        <tr>
          <th>Iteration</th>
          <th>Status</th>
          <th>Files Changed</th>
          <th>Lines Added</th>
          <th>Lines Removed</th>
          <th>Changed Blocks</th>
          <th>Edit Count</th>
          <th>Fallback Used</th>
        </tr>
      </thead>
      <tbody>
      {% for iteration in report.iterations %}
        <tr>
          <td>{{ iteration.iteration|display }}</td>
          <td>{{ iteration.status|display }}</td>
          <td>{{ iteration.diff_stats.files_changed|display }}</td>
          <td>{{ iteration.diff_stats.lines_added|display }}</td>
          <td>{{ iteration.diff_stats.lines_removed|display }}</td>
          <td>{{ iteration.diff_stats.changed_blocks|display }}</td>
          <td>{{ iteration.diff_stats.edit_count|display }}</td>
          <td>{{ iteration.diff_stats.fallback_used|yes_no }}</td>
        </tr>
      {% else %}
        <tr><td colspan="8">No iterations recorded.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  {% if report.reason_summary %}
  <section id="reason-summary">
    <h2>Reason Summary</h2>
    <table>
      <thead><tr><th>Reason</th><th>Count</th><th>Iterations</th></tr></thead>
      <tbody>
      {% for item in report.reason_summary %}
        <tr>
          <td>{{ item.reason|display }}</td>
          <td>{{ item.count|display }}</td>
          <td>{{ item.iterations | join(', ') }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  <section id="closed-loop-selection">
    <h2>Closed-Loop Selection</h2>
    <table>
      <tbody>
        <tr><th>Promotion Policy</th><td>{{ report.closed_loop_selection.promotion_policy|display }}</td></tr>
        <tr><th>Final Current Best Iteration</th><td>{{ report.closed_loop_selection.final_current_best_iteration|display }}</td></tr>
        <tr><th>Final Current Best Is Baseline</th><td>{{ report.closed_loop_selection.final_current_best_is_baseline|yes_no }}</td></tr>
        <tr><th>Final Current Best Run Dir</th><td><code>{{ report.closed_loop_selection.final_current_best_run_dir|display }}</code></td></tr>
        <tr><th>Final Current Best Source Dir</th><td><code>{{ report.closed_loop_selection.final_current_best_source_dir|display }}</code></td></tr>
        <tr><th>Final Current Best Metrics Path</th><td><code>{{ report.closed_loop_selection.final_current_best_metrics_path|display }}</code></td></tr>
        <tr><th>Best Verified Candidate Iteration</th><td>{{ report.closed_loop_selection.best_verified_candidate_iteration|display }}</td></tr>
        <tr><th>Best Verified Candidate Run Dir</th><td><code>{{ report.closed_loop_selection.best_verified_candidate_run_dir|display }}</code></td></tr>
        <tr><th>Best Verified Candidate Speedup vs Baseline</th><td>{{ report.closed_loop_selection.best_verified_candidate_speedup_vs_baseline|display }}</td></tr>
        <tr><th>Best Verified Candidate Runtime Reduction %</th><td>{{ report.closed_loop_selection.best_verified_candidate_runtime_reduction_percent|display }}</td></tr>
        <tr><th>Matches Final Current Best</th><td>{{ report.closed_loop_selection.matches_final_current_best|yes_no }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="per-iteration-table">
    <h2>Per-Iteration Table</h2>
    <table>
      <thead>
        <tr>
          <th>Iteration</th>
          <th>Status</th>
          <th>Runtime ns/case</th>
          <th>Speedup vs Current Best</th>
          <th>Speedup vs Baseline</th>
          <th>Correctness</th>
          <th>Promoted</th>
          <th>Reason Category</th>
          <th>Reason Code</th>
          <th>Expected Effect</th>
          <th>Risk Level</th>
          <th>Summary</th>
          <th>Reason</th>
        </tr>
      </thead>
      <tbody>
      {% for iteration in report.iterations %}
        <tr>
          <td>{{ iteration.iteration|display }}</td>
          <td>{{ iteration.status|display }}</td>
          <td>{{ iteration.runtime_ns_per_case_median|display }}</td>
          <td>{{ iteration.speedup_vs_current_best|display }}</td>
          <td>{{ iteration.speedup_vs_baseline|display }}</td>
          <td>{{ iteration.correctness_passed|yes_no }}</td>
          <td>{{ iteration.promoted|yes_no }}</td>
          <td>{{ iteration.outcome_reason.category|display }}</td>
          <td>{{ iteration.outcome_reason.code|display }}</td>
          <td>{{ iteration.expected_effect|display }}</td>
          <td>{{ iteration.risk_level|display }}</td>
          <td>{{ iteration.candidate_summary|display }}</td>
          <td>{{ iteration.reason|display }}</td>
        </tr>
      {% else %}
        <tr><td colspan="13">No iterations recorded.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="final-best-candidate-summary">
    <h2>Final Best Candidate Summary</h2>
    <table>
      <tbody>
        <tr><th>Final Best Iteration</th><td>{{ report.final_best_candidate.iteration|display }}</td></tr>
        <tr><th>Candidate Run Dir</th><td><code>{{ report.final_best_candidate.candidate_run_dir|display }}</code></td></tr>
        <tr><th>Runtime ns/case</th><td>{{ report.final_best_candidate.runtime_ns_per_case_median|display }}</td></tr>
        <tr><th>Baseline Runtime ns/case</th><td>{{ report.final_best_candidate.baseline_runtime_ns_per_case_median|display }}</td></tr>
        <tr><th>Runtime Improvement ns/case</th><td>{{ report.final_best_candidate.absolute_runtime_difference_ns_per_case|display }}</td></tr>
        <tr><th>Speedup vs Baseline</th><td>{{ report.final_best_candidate.speedup_vs_baseline|display }}</td></tr>
        <tr><th>Runtime Reduction %</th><td>{{ report.final_best_candidate.runtime_reduction_percent|display }}</td></tr>
        <tr><th>Accepted Improvements</th><td>{{ report.final_result.accepted_improvements|display }}</td></tr>
        <tr><th>Correctness Preserved</th><td>{{ report.final_result.correctness_preserved|yes_no }}</td></tr>
        <tr><th>Correctness Passed</th><td>{{ report.final_best_candidate.correctness_passed|yes_no }}</td></tr>
        <tr><th>Candidate Summary</th><td>{{ report.final_best_candidate.candidate_summary|display }}</td></tr>
        <tr><th>Expected Effect</th><td>{{ report.final_best_candidate.expected_effect|display }}</td></tr>
        <tr><th>Risk Level</th><td>{{ report.final_best_candidate.risk_level|display }}</td></tr>
        <tr><th>Changed Files</th><td><code>{{ report.final_best_candidate.changed_files|display }}</code></td></tr>
        <tr><th>Final Optimized Source</th><td><code>{{ report.final_best_candidate.final_optimized_source|display }}</code></td></tr>
        <tr><th>Final Diff</th><td><code>{{ report.final_best_candidate.final_diff|display }}</code></td></tr>
      </tbody>
    </table>
  </section>

  <section id="reporting-status">
    <h2>Reporting Status</h2>
    <table>
      <tbody>
        <tr><th>Enabled</th><td>{{ report.reporting_status.enabled|yes_no }}</td></tr>
        <tr><th>Status</th><td>{{ report.reporting_status.status|display }}</td></tr>
        <tr><th>Formats</th><td>{{ report.reporting_status.formats|display }}</td></tr>
        <tr><th>Renderer</th><td>{{ report.reporting_status.renderer|display }}</td></tr>
        <tr><th>Report Data</th><td><code>{{ report.reporting_status.report_data_path|display }}</code></td></tr>
        <tr><th>Report HTML</th><td><code>{{ report.reporting_status.report_html_path|display }}</code></td></tr>
        <tr><th>PDF Report</th><td>{{ report.reporting_status.pdf_display|display }}</td></tr>
        <tr><th>Error</th><td>{{ report.reporting_status.error|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="artifact-map">
    <h2>Artifact Map</h2>
    <table>
      <thead><tr><th>Artifact</th><th>Path</th></tr></thead>
      <tbody>
      {% for name, value in artifact_items %}
        <tr><td>{{ name }}</td><td><code>{{ value|display }}</code></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="iteration-appendix" class="page-break-before">
    <h2>Iteration Appendix</h2>
    {% for iteration in report.iterations %}
    <article class="appendix-card">
      <h3>Iteration {{ iteration.iteration|display }} <span class="badge">{{ iteration.status|display }}</span></h3>
      <table class="compact">
        <tbody>
          <tr><th>Candidate Summary</th><td>{{ iteration.candidate_summary|display }}</td></tr>
          <tr><th>Expected Effect</th><td>{{ iteration.expected_effect|display }}</td></tr>
          <tr><th>Risk Level</th><td>{{ iteration.risk_level|display }}</td></tr>
          <tr><th>Outcome Category</th><td>{{ iteration.outcome_reason.category|display }}</td></tr>
          <tr><th>Outcome Code</th><td>{{ iteration.outcome_reason.code|display }}</td></tr>
          <tr><th>Outcome Message</th><td>{{ iteration.outcome_reason.message|display }}</td></tr>
          <tr><th>Runtime ns/case</th><td>{{ iteration.runtime_ns_per_case_median|display }}</td></tr>
          <tr><th>Speedup vs Current Best</th><td>{{ iteration.speedup_vs_current_best|display }}</td></tr>
          <tr><th>Speedup vs Baseline</th><td>{{ iteration.speedup_vs_baseline|display }}</td></tr>
          <tr><th>Correctness</th><td>{{ iteration.correctness_passed|yes_no }}</td></tr>
          <tr><th>Promoted</th><td>{{ iteration.promoted|yes_no }}</td></tr>
          <tr><th>Phase Timings</th><td>generation={{ iteration.phase_timings.generation_seconds|display }}, materialization={{ iteration.phase_timings.materialization_seconds|display }}, verification={{ iteration.phase_timings.verification_seconds|display }}, total={{ iteration.phase_timings.total_iteration_seconds|display }}</td></tr>
          <tr><th>LLM Usage</th><td>model={{ iteration.llm_usage.model|display }}, prompt={{ iteration.llm_usage.prompt_tokens|display }}, completion={{ iteration.llm_usage.completion_tokens|display }}, total={{ iteration.llm_usage.total_tokens|display }}, latency={{ iteration.llm_usage.api_latency_seconds|display }}, finish={{ iteration.llm_usage.finish_reason|display }}</td></tr>
          <tr><th>Diff Stats</th><td>files={{ iteration.diff_stats.files_changed|display }}, added={{ iteration.diff_stats.lines_added|display }}, removed={{ iteration.diff_stats.lines_removed|display }}, blocks={{ iteration.diff_stats.changed_blocks|display }}, edits={{ iteration.diff_stats.edit_count|display }}, fallback={{ iteration.diff_stats.fallback_used|yes_no }}</td></tr>
          <tr><th>Candidate Run Dir</th><td><code>{{ iteration.candidate_run_dir|display }}</code></td></tr>
        </tbody>
      </table>
    </article>
    {% else %}
    <p>No iterations recorded.</p>
    {% endfor %}
  </section>
</main>
</body>
</html>
