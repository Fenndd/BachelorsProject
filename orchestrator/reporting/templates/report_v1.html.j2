<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Experiment Report - {{ report.experiment.experiment_id|display }}</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #1f2933;
      --muted: #62717f;
      --line: #d8dee6;
      --panel: #f6f8fa;
      --accent: #246b8f;
    }
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--ink);
      background: #ffffff;
      line-height: 1.45;
    }
    main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 36px 28px 56px;
    }
    header {
      border-bottom: 2px solid var(--line);
      margin-bottom: 28px;
      padding-bottom: 24px;
    }
    h1 {
      margin: 0 0 8px;
      font-size: 32px;
    }
    h2 {
      border-bottom: 1px solid var(--line);
      font-size: 22px;
      margin: 34px 0 14px;
      padding-bottom: 6px;
    }
    .muted {
      color: var(--muted);
    }
    .summary-grid,
    .metric-grid {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    }
    .metric {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 12px;
    }
    .metric strong {
      display: block;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    figure {
      margin: 18px 0;
    }
    figure img {
      border: 1px solid var(--line);
      border-radius: 6px;
      max-width: 100%;
      width: 100%;
      height: auto;
    }
    table {
      border-collapse: collapse;
      font-size: 14px;
      width: 100%;
    }
    th,
    td {
      border: 1px solid var(--line);
      padding: 8px 9px;
      text-align: left;
      vertical-align: top;
    }
    th {
      background: var(--panel);
    }
    code {
      overflow-wrap: anywhere;
      color: #334155;
    }
  </style>
</head>
<body>
<main>
  <header>
    <h1>Experiment Report</h1>
    <p class="muted">Experiment {{ report.experiment.experiment_id|display }} for <code>{{ report.experiment.target_file|display }}</code></p>
  </header>

  <section id="cover">
    <h2>Cover</h2>
    <div class="summary-grid">
      <div class="metric"><strong>Experiment ID</strong>{{ report.experiment.experiment_id|display }}</div>
      <div class="metric"><strong>Target File</strong><code>{{ report.experiment.target_file|display }}</code></div>
      <div class="metric"><strong>Generated At</strong>{{ report.report_metadata.generated_at|display }}</div>
      <div class="metric"><strong>Report Profile</strong>{{ report.report_metadata.report_profile|display }}</div>
    </div>
  </section>

  <section id="executive-summary">
    <h2>Executive Summary</h2>
    <div class="metric-grid">
      <div class="metric"><strong>Final Best Iteration</strong>{{ report.final_result.final_best_iteration|display }}</div>
      <div class="metric"><strong>Final Speedup vs Baseline</strong>{{ report.final_result.final_speedup_vs_baseline|display }}</div>
      <div class="metric"><strong>Final Runtime Reduction Percent</strong>{{ report.final_result.final_runtime_reduction_percent|display }}</div>
      <div class="metric"><strong>Accepted Improvements</strong>{{ report.final_result.accepted_improvements|display }}</div>
      <div class="metric"><strong>Correctness Preserved</strong>{{ report.final_result.correctness_preserved|yes_no }}</div>
    </div>
  </section>

  <section id="experiment-configuration">
    <h2>Experiment Configuration</h2>
    <table>
      <tbody>
        <tr><th>Experiment Name</th><td>{{ report.experiment.experiment_name|display }}</td></tr>
        <tr><th>Model</th><td>{{ report.experiment.model|display }}</td></tr>
        <tr><th>Candidate Format</th><td>{{ report.experiment.candidate_format|display }}</td></tr>
        <tr><th>Source Presentation</th><td>{{ report.experiment.source_presentation|display }}</td></tr>
        <tr><th>Total Iterations</th><td>{{ report.experiment.total_iterations|display }}</td></tr>
        <tr><th>Completed Iterations</th><td>{{ report.experiment.completed_iterations|display }}</td></tr>
        <tr><th>Closed Loop Enabled</th><td>{{ report.experiment.closed_loop_enabled|yes_no }}</td></tr>
        <tr><th>Benchmark Family</th><td>{{ report.experiment.benchmark_family|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="baseline-metrics">
    <h2>Baseline Metrics</h2>
    <div class="metric-grid">
      <div class="metric"><strong>Median Runtime ns/case</strong>{{ report.baseline_metrics.runtime_ns_per_case_median|display }}</div>
      <div class="metric"><strong>Success Rate</strong>{{ report.baseline_metrics.success_rate|display }}</div>
      <div class="metric"><strong>Mean Reprojection Error</strong>{{ report.baseline_metrics.mean_reprojection_error|display }}</div>
      <div class="metric"><strong>Max Reprojection Error</strong>{{ report.baseline_metrics.max_reprojection_error|display }}</div>
      <div class="metric"><strong>Correctness Passed</strong>{{ report.baseline_metrics.correctness_passed|yes_no }}</div>
    </div>
  </section>

  <section id="runtime-progress">
    <h2>Runtime Progress</h2>
    <figure><img src="{{ plots.runtime_progress }}" alt="Runtime progress plot"></figure>
    <figure><img src="{{ plots.runtime_reduction_by_iteration }}" alt="Runtime reduction by iteration plot"></figure>
  </section>

  <section id="correctness-and-accuracy-safety">
    <h2>Correctness and Accuracy Safety</h2>
    <figure><img src="{{ plots.correctness_metrics }}" alt="Correctness metrics plot"></figure>
  </section>

  <section id="status-breakdown">
    <h2>Status Breakdown</h2>
    <figure><img src="{{ plots.status_breakdown }}" alt="Status breakdown plot"></figure>
    <table>
      <thead><tr><th>Status</th><th>Count</th></tr></thead>
      <tbody>
      {% for status, count in status_items %}
        <tr><td>{{ status }}</td><td>{{ count }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="candidate-funnel">
    <h2>Candidate Funnel</h2>
    <figure><img src="{{ plots.candidate_funnel }}" alt="Candidate funnel plot"></figure>
  </section>

  <section id="per-iteration-table">
    <h2>Per-Iteration Table</h2>
    <table>
      <thead>
        <tr>
          <th>Iteration</th>
          <th>Status</th>
          <th>Runtime ns/case</th>
          <th>Speedup vs Baseline</th>
          <th>Correctness</th>
          <th>Promoted</th>
          <th>Summary</th>
          <th>Reason</th>
        </tr>
      </thead>
      <tbody>
      {% for iteration in report.iterations %}
        <tr>
          <td>{{ iteration.iteration|display }}</td>
          <td>{{ iteration.status|display }}</td>
          <td>{{ iteration.runtime_ns_per_case_median|display }}</td>
          <td>{{ iteration.speedup_vs_baseline|display }}</td>
          <td>{{ iteration.correctness_passed|yes_no }}</td>
          <td>{{ iteration.promoted|yes_no }}</td>
          <td>{{ iteration.candidate_summary|display }}</td>
          <td>{{ iteration.reason|display }}</td>
        </tr>
      {% else %}
        <tr><td colspan="8">No iterations recorded.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="final-best-candidate-summary">
    <h2>Final Best Candidate Summary</h2>
    <table>
      <tbody>
        <tr><th>Final Best Iteration</th><td>{{ report.final_result.final_best_iteration|display }}</td></tr>
        <tr><th>Final Speedup vs Baseline</th><td>{{ report.final_result.final_speedup_vs_baseline|display }}</td></tr>
        <tr><th>Final Runtime Reduction Percent</th><td>{{ report.final_result.final_runtime_reduction_percent|display }}</td></tr>
        <tr><th>Accepted Improvements</th><td>{{ report.final_result.accepted_improvements|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="artifact-map">
    <h2>Artifact Map</h2>
    <table>
      <thead><tr><th>Artifact</th><th>Path</th></tr></thead>
      <tbody>
      {% for name, value in artifact_items %}
        <tr><td>{{ name }}</td><td><code>{{ value|display }}</code></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
</main>
</body>
</html>
