<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Experiment Report - {{ report.experiment.experiment_id|display }}</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #1f2933;
      --muted: #62717f;
      --line: #d8dee6;
      --panel: #f6f8fa;
      --accent: #246b8f;
    }
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--ink);
      background: #ffffff;
      line-height: 1.45;
    }
    main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 36px 28px 56px;
    }
    header {
      border-bottom: 2px solid var(--line);
      margin-bottom: 28px;
      padding-bottom: 24px;
    }
    h1 {
      margin: 0 0 8px;
      font-size: 32px;
    }
    h2 {
      border-bottom: 1px solid var(--line);
      font-size: 22px;
      margin: 34px 0 14px;
      padding-bottom: 6px;
    }
    .muted {
      color: var(--muted);
    }
    .summary-grid,
    .metric-grid {
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    }
    .metric {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 12px;
    }
    .metric strong {
      display: block;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 4px;
    }
    figure {
      margin: 18px 0;
    }
    figure img {
      border: 1px solid var(--line);
      border-radius: 6px;
      max-width: 100%;
      width: 100%;
      height: auto;
    }
    table {
      border-collapse: collapse;
      font-size: 14px;
      width: 100%;
    }
    th,
    td {
      border: 1px solid var(--line);
      padding: 8px 9px;
      text-align: left;
      vertical-align: top;
    }
    th {
      background: var(--panel);
    }
    code {
      overflow-wrap: anywhere;
      color: #334155;
    }
  </style>
</head>
<body>
<main>
  <header>
    <h1>Experiment Report</h1>
    <p class="muted">Experiment {{ report.experiment.experiment_id|display }} for <code>{{ report.experiment.target_file|display }}</code></p>
  </header>

  <section id="cover">
    <h2>Cover</h2>
    <div class="summary-grid">
      <div class="metric"><strong>Experiment ID</strong>{{ report.experiment.experiment_id|display }}</div>
      <div class="metric"><strong>Experiment Name</strong>{{ report.experiment.experiment_name|display }}</div>
      <div class="metric"><strong>Target File</strong><code>{{ report.experiment.target_file|display }}</code></div>
      <div class="metric"><strong>Generated At</strong>{{ report.report_metadata.generated_at|display }}</div>
      <div class="metric"><strong>Report Profile</strong>{{ report.report_metadata.report_profile|display }}</div>
    </div>
  </section>

  <section id="executive-summary">
    <h2>Executive Summary</h2>
    <div class="metric-grid">
      <div class="metric"><strong>Final Best Iteration</strong>{{ report.final_result.final_best_iteration|display }}</div>
      <div class="metric"><strong>Final Speedup vs Baseline</strong>{{ report.final_result.final_speedup_vs_baseline|display }}</div>
      <div class="metric"><strong>Final Runtime Reduction %</strong>{{ report.final_result.final_runtime_reduction_percent|display }}</div>
      <div class="metric"><strong>Accepted Improvements</strong>{{ report.final_result.accepted_improvements|display }}</div>
      <div class="metric"><strong>Correctness Preserved</strong>{{ report.final_result.correctness_preserved|yes_no }}</div>
      <div class="metric"><strong>Baseline Runtime ns/case</strong>{{ report.baseline_metrics.runtime_ns_per_case_median|display }}</div>
      <div class="metric"><strong>Final Best Runtime ns/case</strong>{{ report.final_best_candidate.runtime_ns_per_case_median|display }}</div>
      <div class="metric"><strong>Absolute Runtime Difference ns/case</strong>{{ report.final_best_candidate.absolute_runtime_difference_ns_per_case|display }}</div>
      <div class="metric"><strong>PDF Report</strong>{{ report.reporting_status.pdf_display|display }}</div>
    </div>
  </section>

  <section id="experiment-configuration">
    <h2>Experiment Configuration</h2>
    <table>
      <tbody>
        <tr><th>Experiment Name</th><td>{{ report.experiment.experiment_name|display }}</td></tr>
        <tr><th>Description</th><td>{{ report.experiment_config_details.description|display }}</td></tr>
        <tr><th>Target File</th><td><code>{{ report.experiment.target_file|display }}</code></td></tr>
        <tr><th>LLM Provider</th><td>{{ report.llm.provider|display }}</td></tr>
        <tr><th>Model</th><td>{{ report.llm.model|display }}</td></tr>
        <tr><th>LLM Config</th><td>{{ report.llm.llm_config|display }}</td></tr>
        <tr><th>Thinking Enabled</th><td>{{ report.llm.thinking_enabled|yes_no }}</td></tr>
        <tr><th>Thinking Effort</th><td>{{ report.llm.thinking_effort|display }}</td></tr>
        <tr><th>Max Tokens</th><td>{{ report.llm.max_tokens|display }}</td></tr>
        <tr><th>Variant ID</th><td>{{ report.llm.variant_id|display }}</td></tr>
        <tr><th>Variant Description</th><td>{{ report.llm.variant_description|display }}</td></tr>
        <tr><th>Candidate Format</th><td>{{ report.experiment.candidate_format|display }}</td></tr>
        <tr><th>Source Presentation</th><td>{{ report.experiment.source_presentation|display }}</td></tr>
        <tr><th>Require Original Verification</th><td>{{ report.experiment_config_details.require_original_verification|yes_no }}</td></tr>
        <tr><th>Allow Exact Search Fallback</th><td>{{ report.experiment_config_details.allow_exact_search_fallback|yes_no }}</td></tr>
        <tr><th>Max Source Chars</th><td>{{ report.experiment_config_details.candidate_generation_max_source_chars|display }}</td></tr>
        <tr><th>Total Iterations</th><td>{{ report.experiment.total_iterations|display }}</td></tr>
        <tr><th>Completed Iterations</th><td>{{ report.experiment.completed_iterations|display }}</td></tr>
        <tr><th>Closed Loop Enabled</th><td>{{ report.experiment.closed_loop_enabled|yes_no }}</td></tr>
        <tr><th>History Policy Enabled</th><td>{{ report.experiment_config_details.history_policy_enabled|yes_no }}</td></tr>
        <tr><th>History Policy Scope</th><td>{{ report.experiment_config_details.history_policy_scope|display }}</td></tr>
        <tr><th>Selection Enabled</th><td>{{ report.experiment_config_details.selection_enabled|yes_no }}</td></tr>
        <tr><th>Baseline Run Dir</th><td><code>{{ report.experiment_config_details.selection_baseline_run_dir|display }}</code></td></tr>
        <tr><th>Optimization Scope</th><td><code>{{ report.experiment_config_details.optimization_scope_allowed_files|display }}</code></td></tr>
        <tr><th>Reporting Enabled</th><td>{{ report.experiment_config_details.reporting_enabled|yes_no }}</td></tr>
        <tr><th>Reporting Formats</th><td>{{ report.experiment_config_details.reporting_formats|display }}</td></tr>
        <tr><th>Reporting Renderer</th><td>{{ report.experiment_config_details.reporting_renderer|display }}</td></tr>
        <tr><th>Benchmark Family</th><td>{{ report.experiment.benchmark_family|display }}</td></tr>
        <tr><th>Build Type</th><td>{{ report.benchmark_config.build_type|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="benchmark-configuration">
    <h2>Benchmark Configuration</h2>
    <table>
      <tbody>
        <tr><th>Family</th><td>{{ report.benchmark_config.family|display }}</td></tr>
        <tr><th>Solver</th><td>{{ report.benchmark_config.solver|display }}</td></tr>
        <tr><th>Num Cases</th><td>{{ report.benchmark_config.num_cases|display }}</td></tr>
        <tr><th>Points per Case</th><td>{{ report.benchmark_config.points_per_case|display }}</td></tr>
        <tr><th>Warmup Iterations</th><td>{{ report.benchmark_config.warmup_iterations|display }}</td></tr>
        <tr><th>Timed Iterations</th><td>{{ report.benchmark_config.timed_iterations|display }}</td></tr>
        <tr><th>Seed</th><td>{{ report.benchmark_config.seed|display }}</td></tr>
        <tr><th>Runtime Unit</th><td>{{ report.benchmark_config.runtime_unit|display }}</td></tr>
        <tr><th>Reprojection Error Threshold</th><td>{{ report.benchmark_config.reprojection_error_threshold|display }}</td></tr>
        <tr><th>Minimum Success Rate</th><td>{{ report.benchmark_config.minimum_success_rate|display }}</td></tr>
        <tr><th>Require All Cases Valid</th><td>{{ report.benchmark_config.require_all_cases_valid|yes_no }}</td></tr>
        <tr><th>Use Max Reprojection Error as Hard Gate</th><td>{{ report.benchmark_config.use_max_reprojection_error_as_hard_gate|yes_no }}</td></tr>
        <tr><th>Build Type</th><td>{{ report.benchmark_config.build_type|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="baseline-metrics">
    <h2>Baseline Metrics</h2>
    <div class="metric-grid">
      <div class="metric"><strong>Median Runtime ns/case</strong>{{ report.baseline_metrics.runtime_ns_per_case_median|display }}</div>
      <div class="metric"><strong>Success Rate</strong>{{ report.baseline_metrics.success_rate|display }}</div>
      <div class="metric"><strong>Mean Reprojection Error</strong>{{ report.baseline_metrics.mean_reprojection_error|display }}</div>
      <div class="metric"><strong>Max Reprojection Error</strong>{{ report.baseline_metrics.max_reprojection_error|display }}</div>
      <div class="metric"><strong>Correctness Passed</strong>{{ report.baseline_metrics.correctness_passed|yes_no }}</div>
    </div>
  </section>

  <section id="runtime-progress">
    <h2>Runtime Progress</h2>
    <figure><img src="{{ plots.runtime_progress }}" alt="Runtime progress plot"></figure>
    <figure><img src="{{ plots.runtime_reduction_by_iteration }}" alt="Runtime reduction by iteration plot"></figure>
  </section>

  <section id="correctness-and-accuracy-safety">
    <h2>Correctness and Accuracy Safety</h2>
    <figure><img src="{{ plots.correctness_metrics }}" alt="Correctness metrics plot"></figure>
  </section>

  <section id="status-breakdown">
    <h2>Status Breakdown</h2>
    <figure><img src="{{ plots.status_breakdown }}" alt="Status breakdown plot"></figure>
    <table>
      <thead><tr><th>Status</th><th>Count</th></tr></thead>
      <tbody>
      {% for status, count in status_items %}
        <tr><td>{{ status }}</td><td>{{ count }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="candidate-funnel">
    <h2>Candidate Funnel</h2>
    <figure><img src="{{ plots.candidate_funnel }}" alt="Candidate funnel plot"></figure>
  </section>

  <section id="closed-loop-selection">
    <h2>Closed-Loop Selection</h2>
    <table>
      <tbody>
        <tr><th>Promotion Policy</th><td>{{ report.closed_loop_selection.promotion_policy|display }}</td></tr>
        <tr><th>Final Current Best Iteration</th><td>{{ report.closed_loop_selection.final_current_best_iteration|display }}</td></tr>
        <tr><th>Final Current Best Is Baseline</th><td>{{ report.closed_loop_selection.final_current_best_is_baseline|yes_no }}</td></tr>
        <tr><th>Final Current Best Run Dir</th><td><code>{{ report.closed_loop_selection.final_current_best_run_dir|display }}</code></td></tr>
        <tr><th>Final Current Best Source Dir</th><td><code>{{ report.closed_loop_selection.final_current_best_source_dir|display }}</code></td></tr>
        <tr><th>Final Current Best Metrics Path</th><td><code>{{ report.closed_loop_selection.final_current_best_metrics_path|display }}</code></td></tr>
        <tr><th>Best Verified Candidate Iteration</th><td>{{ report.closed_loop_selection.best_verified_candidate_iteration|display }}</td></tr>
        <tr><th>Best Verified Candidate Run Dir</th><td><code>{{ report.closed_loop_selection.best_verified_candidate_run_dir|display }}</code></td></tr>
        <tr><th>Best Verified Candidate Speedup vs Baseline</th><td>{{ report.closed_loop_selection.best_verified_candidate_speedup_vs_baseline|display }}</td></tr>
        <tr><th>Best Verified Candidate Runtime Reduction %</th><td>{{ report.closed_loop_selection.best_verified_candidate_runtime_reduction_percent|display }}</td></tr>
        <tr><th>Matches Final Current Best</th><td>{{ report.closed_loop_selection.matches_final_current_best|yes_no }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="per-iteration-table">
    <h2>Per-Iteration Table</h2>
    <table>
      <thead>
        <tr>
          <th>Iteration</th>
          <th>Status</th>
          <th>Runtime ns/case</th>
          <th>Speedup vs Current Best</th>
          <th>Speedup vs Baseline</th>
          <th>Correctness</th>
          <th>Promoted</th>
          <th>Expected Effect</th>
          <th>Risk Level</th>
          <th>Summary</th>
          <th>Reason</th>
        </tr>
      </thead>
      <tbody>
      {% for iteration in report.iterations %}
        <tr>
          <td>{{ iteration.iteration|display }}</td>
          <td>{{ iteration.status|display }}</td>
          <td>{{ iteration.runtime_ns_per_case_median|display }}</td>
          <td>{{ iteration.speedup_vs_current_best|display }}</td>
          <td>{{ iteration.speedup_vs_baseline|display }}</td>
          <td>{{ iteration.correctness_passed|yes_no }}</td>
          <td>{{ iteration.promoted|yes_no }}</td>
          <td>{{ iteration.expected_effect|display }}</td>
          <td>{{ iteration.risk_level|display }}</td>
          <td>{{ iteration.candidate_summary|display }}</td>
          <td>{{ iteration.reason|display }}</td>
        </tr>
      {% else %}
        <tr><td colspan="11">No iterations recorded.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="final-best-candidate-summary">
    <h2>Final Best Candidate Summary</h2>
    <table>
      <tbody>
        <tr><th>Final Best Iteration</th><td>{{ report.final_best_candidate.iteration|display }}</td></tr>
        <tr><th>Candidate Run Dir</th><td><code>{{ report.final_best_candidate.candidate_run_dir|display }}</code></td></tr>
        <tr><th>Runtime ns/case</th><td>{{ report.final_best_candidate.runtime_ns_per_case_median|display }}</td></tr>
        <tr><th>Baseline Runtime ns/case</th><td>{{ report.final_best_candidate.baseline_runtime_ns_per_case_median|display }}</td></tr>
        <tr><th>Absolute Runtime Difference ns/case</th><td>{{ report.final_best_candidate.absolute_runtime_difference_ns_per_case|display }}</td></tr>
        <tr><th>Speedup vs Baseline</th><td>{{ report.final_best_candidate.speedup_vs_baseline|display }}</td></tr>
        <tr><th>Runtime Reduction %</th><td>{{ report.final_best_candidate.runtime_reduction_percent|display }}</td></tr>
        <tr><th>Accepted Improvements</th><td>{{ report.final_result.accepted_improvements|display }}</td></tr>
        <tr><th>Correctness Preserved</th><td>{{ report.final_result.correctness_preserved|yes_no }}</td></tr>
        <tr><th>Correctness Passed</th><td>{{ report.final_best_candidate.correctness_passed|yes_no }}</td></tr>
        <tr><th>Candidate Summary</th><td>{{ report.final_best_candidate.candidate_summary|display }}</td></tr>
        <tr><th>Expected Effect</th><td>{{ report.final_best_candidate.expected_effect|display }}</td></tr>
        <tr><th>Risk Level</th><td>{{ report.final_best_candidate.risk_level|display }}</td></tr>
        <tr><th>Changed Files</th><td><code>{{ report.final_best_candidate.changed_files|display }}</code></td></tr>
        <tr><th>Final Optimized Source</th><td><code>{{ report.final_best_candidate.final_optimized_source|display }}</code></td></tr>
        <tr><th>Final Diff</th><td><code>{{ report.final_best_candidate.final_diff|display }}</code></td></tr>
      </tbody>
    </table>
  </section>

  <section id="reporting-status">
    <h2>Reporting Status</h2>
    <table>
      <tbody>
        <tr><th>Enabled</th><td>{{ report.reporting_status.enabled|yes_no }}</td></tr>
        <tr><th>Status</th><td>{{ report.reporting_status.status|display }}</td></tr>
        <tr><th>Formats</th><td>{{ report.reporting_status.formats|display }}</td></tr>
        <tr><th>Renderer</th><td>{{ report.reporting_status.renderer|display }}</td></tr>
        <tr><th>Report Data</th><td><code>{{ report.reporting_status.report_data_path|display }}</code></td></tr>
        <tr><th>Report HTML</th><td><code>{{ report.reporting_status.report_html_path|display }}</code></td></tr>
        <tr><th>PDF Report</th><td>{{ report.reporting_status.pdf_display|display }}</td></tr>
        <tr><th>Error</th><td>{{ report.reporting_status.error|display }}</td></tr>
      </tbody>
    </table>
  </section>

  <section id="artifact-map">
    <h2>Artifact Map</h2>
    <table>
      <thead><tr><th>Artifact</th><th>Path</th></tr></thead>
      <tbody>
      {% for name, value in artifact_items %}
        <tr><td>{{ name }}</td><td><code>{{ value|display }}</code></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
</main>
</body>
</html>
