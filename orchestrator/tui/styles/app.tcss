/* ===================================================================
   app.tcss -- application shell, base theme, dialog screens
   Light theme palette:
     surface:     #f7f7f5
     panel:       #ffffff
     panel-alt:   #eef0f3
     border:      #d6d8de
     text:        #1f2937
     text-muted:  #6b7280
     accent:      #2563eb
     success:     #15803d
     warning:     #b45309
     error:       #b91c1c
   =================================================================== */

Screen {
    background: #f7f7f5;
    color: #1f2937;
}

Header {
    dock: top;
    background: #1f2937;
    color: #f8fafc;
}

Footer {
    dock: bottom;
    background: #1f2937;
    color: #f8fafc;
}

.panel {
    background: #ffffff;
    border: solid #d6d8de;
    padding: 1 2;
    margin-bottom: 1;
}

.title {
    text-style: bold;
    color: #1f2937;
    margin-bottom: 1;
}

.subtitle {
    color: #4b5563;
    margin-bottom: 1;
}

Button {
    width: 100%;
}

ListView {
    background: #ffffff;
    color: #1f2937;
}

RichLog {
    background: #ffffff;
    color: #1f2937;
}

/* ---- QuitConfirmScreen dialog ---- */

QuitConfirmScreen {
    align: center middle;
}

#quit-confirm-dialog {
    background: #1f2937;
    border: solid #b91c1c;
    padding: 2 3;
    width: 52;
    height: auto;
}

#quit-confirm-dialog Static {
    text-style: bold;
    color: #f8fafc;
    margin-bottom: 1;
}

#quit-confirm-dialog Button {
    width: 100%;
    text-style: bold;
}
