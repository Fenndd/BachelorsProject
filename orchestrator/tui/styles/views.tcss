/* ===================================================================
   views.tcss -- content area and view-specific styling
   =================================================================== */

#content {
    background: #ffffff;
    padding: 1 2;
    height: 1fr;
}

#content > * {
    height: 1fr;
}

/* ---- Actions button row ---- */

.actions {
    height: auto;
    min-height: 3;
    margin-top: 1;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
    color: #1f2937;
    text-style: bold;
}

#content Button {
    background: #e5e7eb;
    color: #111827;
    border: tall #9ca3af;
    text-style: bold;
    min-height: 3;
}

#content Button:hover {
    background: #d1d5db;
    color: #111827;
}

#content Button:disabled {
    background: #f3f4f6;
    color: #6b7280;
}

/* ---- Results view: filter row ---- */

#results-view {
    height: 1fr;
}

#filter-row {
    height: auto;
    margin-bottom: 1;
}

#filter-row Input {
    width: 1fr;
    margin-right: 1;
}

#filter-row Select {
    width: 20;
}

/* ---- Results view: DataTable ---- */

DataTable {
    background: #ffffff;
    color: #1f2937;
}

#results-table {
    height: 1fr;
    min-height: 6;
}

DataTable > .datatable--header {
    background: #eef0f3;
    color: #1f2937;
}

DataTable > .datatable--cursor {
    background: #dbeafe;
    color: #1f2937;
}

/* ---- Results view: summary and status ---- */

#result-summary-panel {
    height: 1fr;
    min-height: 10;
    padding: 1 2;
}

#result-summary-text {
    height: auto;
}

#results-status {
    min-height: 1;
    height: auto;
}

/* ---- Experiment view ---- */

#experiments-view {
    height: 1fr;
}

#experiments-scroll {
    height: 1fr;
    min-height: 8;
}

#experiment-list {
    min-height: 5;
}

#experiment-summary {
    height: auto;
}

/* ---- System view ---- */

#system-view {
    height: 1fr;
}

#system-scroll {
    height: 1fr;
    min-height: 8;
}

#system-actions Button {
    width: 1fr;
}

.bottom-spacer {
    height: 2;
}

/* ---- Config builder view ---- */

#config-builder-view {
    height: 1fr;
    padding: 0 1;
}

#builder-form {
    height: auto;
    padding: 0 1;
}

#build-errors {
    height: 6;
    min-height: 4;
}

#builder-buttons,
#builder-buttons-extra {
    height: auto;
    min-height: 3;
    margin-top: 1;
}

.builder-button {
    width: 1fr;
}

/* ---- Active run live log screen ---- */

#run-status {
    height: auto;
    min-height: 6;
    margin-bottom: 1;
}

#run-log {
    height: 1fr;
    min-height: 8;
    margin-bottom: 1;
}

.run-action-row {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    margin-top: 1;
}

.run-action-button {
    width: 100%;
}
