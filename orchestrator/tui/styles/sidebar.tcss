/* ===================================================================
   sidebar.tcss -- left navigation sidebar and active runs panel
   =================================================================== */

#layout {
    height: 1fr;
}

#sidebar {
    width: 22;
    background: #eef0f3;
    border-right: solid #d6d8de;
    padding: 1;
}

.sidebar-title {
    text-style: bold;
    color: #1f2937;
    margin-bottom: 1;
    padding: 0 1;
}

.sidebar-separator {
    height: 1;
    margin: 1 0;
    background: #d6d8de;
}

#nav {
    height: auto;
    background: #eef0f3;
    border: none;
}

#nav ListItem {
    padding: 0 1;
}

#nav ListItem:hover {
    background: #2563eb;
    color: #ffffff;
}

#active-runs-title {
    text-style: bold;
    color: #4b5563;
    margin-top: 1;
    padding: 0 1;
}

#active-runs {
    height: auto;
    min-height: 3;
    max-height: 12;
    background: #eef0f3;
    border: none;
    margin-top: 0;
}

#active-runs ListItem {
    padding: 0 1;
}

#active-runs ListItem:hover {
    background: #2563eb;
    color: #ffffff;
}
