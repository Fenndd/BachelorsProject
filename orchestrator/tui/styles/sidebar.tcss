/* ===================================================================
   sidebar.tcss -- left navigation sidebar and active runs panel
   =================================================================== */

#layout {
    height: 1fr;
}

#sidebar {
    width: 22;
    background: #eef0f3;
    border-right: solid #d6d8de;
    padding: 1;
}

#nav {
    height: auto;
    background: #eef0f3;
    color: #111827;
    border: none;
}

#nav ListItem {
    padding: 0 1;
    background: #eef0f3;
    color: #111827;
    margin-bottom: 0;
    border-bottom: solid #d6d8de;
}

#nav ListItem Static {
    color: #111827;
}

#nav ListItem.-highlight {
    background: #dbeafe;
    color: #111827;
    text-style: bold;
}

#nav ListItem.-highlight Static {
    color: #111827;
}

#nav ListItem.-hovered {
    background: #bfdbfe;
    color: #111827;
}

#nav ListItem.-hovered Static {
    color: #111827;
    text-style: bold;
}

#global-refresh {
    margin: 1 0;
    width: 7;
    min-height: 3;
    background: #d1d5db;
    color: #111827;
    border: tall #9ca3af;
    text-style: bold;
}

#global-refresh:hover {
    background: #9ca3af;
    color: #111827;
}

#clear-finished-runs {
    margin: 0 0 1 0;
    width: 100%;
    background: #d1d5db;
    color: #111827;
    border: tall #9ca3af;
    text-style: bold;
}

#clear-finished-runs:hover {
    background: #9ca3af;
    color: #111827;
}

#active-runs-title {
    text-style: bold;
    color: #4b5563;
    margin-top: 1;
    padding: 0 1;
}

#active-runs {
    height: auto;
    min-height: 3;
    max-height: 12;
    background: #eef0f3;
    color: #111827;
    border: none;
    margin-top: 0;
}

#active-runs ListItem {
    padding: 0 1;
    background: #eef0f3;
    color: #111827;
}

#active-runs ListItem Static {
    color: #111827;
}

#active-runs ListItem.-highlight {
    background: #dbeafe;
    color: #111827;
}

#active-runs ListItem.-highlight Static {
    color: #111827;
}

#active-runs ListItem.-hovered {
    background: #2563eb;
    color: #ffffff;
}

#active-runs ListItem.-hovered Static {
    color: #ffffff;
}
