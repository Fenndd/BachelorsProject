{
  "experiment_name": "mock_p3p_line_range_full_cycle_selection",
  "description": "Offline mock full-cycle P3P experiment for line_range_edits candidate generation, materialization, verification, and selection without a real LLM API call.",
  "llm_config": "configs/llm_mock_line_range_p3p.json",
  "target_file": "cpp/external/lambdatwist/p3p.cc",
